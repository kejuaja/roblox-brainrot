{
  "name": "brainrot-tsunami-tycoon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CameraMaxZoomDistance": 80
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2.5,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
